# Dockerfile.frontend — React SPA (Vite or CRA)
# Multi-stage: Node build → NGINX static serve
#
# Build args:
#   VITE_API_URL     — API base URL injected at build time (Vite)
#   REACT_APP_API_URL — API base URL for CRA projects
#   NODE_ENV         — staging | production

ARG NODE_VERSION=20-alpine
ARG NGINX_VERSION=alpine

# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS builder

ARG NODE_ENV=production
ARG VITE_API_URL=""
ARG REACT_APP_API_URL=""

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Inject env vars for build-time substitution
ENV VITE_API_URL=${VITE_API_URL}
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV NODE_ENV=${NODE_ENV}

RUN npm run build

# ─── Stage 2: NGINX static server ────────────────────────────────────────────
FROM nginx:${NGINX_VERSION} AS production

# Remove default NGINX config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our hardened NGINX config (includes all required security headers)
COPY nginx.conf /etc/nginx/conf.d/app.conf

# Copy built React app
# Vite outputs to /dist; CRA outputs to /build — adjust if needed
COPY --from=builder /app/dist  /usr/share/nginx/html
# COPY --from=builder /app/build /usr/share/nginx/html

# Health check endpoint (NGINX returns 200 on /)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
