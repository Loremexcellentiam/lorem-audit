# .env.example
# All keys required by the application.
# Copy to .env.local (gitignored) for local dev.
# Every key here must be present in GitHub Secrets for staging and production.
# Values are masked — never commit real secrets to this file.

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=
PORT=

# ── Database (Sequelize) ──────────────────────────────────────────────────
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY=

# ── Frontend API URL ──────────────────────────────────────────────────────
VITE_API_URL=
# REACT_APP_API_URL=    # Use this instead if using CRA

# ── Email (e.g. Nodemailer / SMTP) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Payments (example) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── Deployment ────────────────────────────────────────────────────────────
# (These are set automatically in GitHub Actions — do not set them manually)
# GITHUB_SHA=
# COMMIT_SHA=
