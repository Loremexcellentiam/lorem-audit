# Dockerfile.nextjs — Next.js (static export mode: output: 'export')
# Multi-stage: build → NGINX serve
#
# next.config.js must have: output: 'export'
# Static files exported to /out directory

ARG NODE_VERSION=20-alpine

# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS builder

ARG NODE_ENV=production
ARG NEXT_PUBLIC_API_URL=""
ARG COMMIT_SHA=local

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NODE_ENV=${NODE_ENV}
ENV NEXT_TELEMETRY_DISABLED=1

# next build + export (generates /out directory)
RUN npm run build

# ─── Stage 2: NGINX static server ────────────────────────────────────────────
FROM nginx:alpine AS production

RUN rm /etc/nginx/conf.d/default.conf

# Hardened NGINX config with security headers (shared across frontend + next)
COPY nginx.conf /etc/nginx/conf.d/app.conf

# Next.js static export output
COPY --from=builder /app/out /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
